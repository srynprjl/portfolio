[TEMPLATE]
# Copy to .env and adjust. Dynamic features (API + /admin) only run
# when the TanStack Start node server is running — not on static hosts.
ADMIN_PASSWORD=change-me

# Database: sqlite (default), mariadb, or turso
DB_DRIVER=sqlite

# SQLite (used when DB_DRIVER=sqlite)
SQLITE_PATH=./data/portfolio.db

# MariaDB (used when DB_DRIVER=mariadb)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=portfolio
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=portfolio

# Turso / libSQL (used when DB_DRIVER=turso)
# Sign up at https://turso.tech and create a database.
# Get your URL:    turso db show <db-name> --url
# Get your token:  turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
